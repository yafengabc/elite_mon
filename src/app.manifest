<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  应用程序清单。作用只有一个：让 Windows 为进程加载 comctl32 v6（视觉样式），
  控件于是按「当前系统的现代主题」绘制（Win7 的 Aero、Win10/11 的扁平主题），
  而不是退化成 Win95/98 那套 3D 凹凸灰。

  没有这一条依赖，即使系统主题再新，程序里的按钮/滚动条/页签也一律按经典样式画 ——
  这是「Win32 程序看起来像 Win9x」的头号原因，和自绘无关。

  构建： ./build.sh 会自动调 rsrc 把它和 src/icon/app.ico 一起编成临时 .syso：
         GOSUMDB=off go run github.com/akavel/rsrc@v0.10.2 \
             -manifest src/app.manifest -ico src/icon/app.ico -arch amd64 -o src/rsrc_windows_amd64.syso
         （.syso 会被 go build 自动链进 Windows/amd64 产物；Linux 构建忽略它；
           用完由 build.sh 的 trap 删除，源码目录不留编译产物）

  资源 ID 由 rsrc 按参数顺序分配，这就是 win32.go 里那两个常量的来源：
         清单 = 1（RT_MANIFEST）      图标组 = 2（RT_GROUP_ICON，RT_ICON 从 3 起）
  一个 exe 只能有一份 .rsrc，所以清单和图标必须一次生成，不能分两个 .syso。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="EliteMon.UI"
      version="1.0.0.0"
      processorArchitecture="*"/>
  <description>精英危险 实时监控</description>

  <!-- 关键：声明依赖公共控件 6.0，Windows 才会启用视觉样式 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 声明支持 Win7 ~ Win11：不写的话新系统会给进程套兼容性 shim，主题行为会打折 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/> <!-- Windows 7 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- Windows 8 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Windows 8.1 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 / 11 -->
    </application>
  </compatibility>
</assembly>
